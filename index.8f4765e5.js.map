'use strict';
var navButtons = document.querySelectorAll('.navigation-btn');
var slidesContainer = document.querySelector('.imgs-slides');
var updateSlider = function(index) {
    var slideWidth = document.querySelector('.slide').offsetWidth;
    slidesContainer.style.marginLeft = "-".concat(index * slideWidth, "px");
    navButtons.forEach(function(btn, i) {
        if (i === index) btn.classList.add('active');
        else btn.classList.remove('active');
    });
};
navButtons.forEach(function(btn) {
    btn.addEventListener('click', function() {
        var index = parseInt(btn.getAttribute('data-slide'));
        updateSlider(index);
    });
});
window.addEventListener('load', function() {
    updateSlider(0);
    navButtons[0].classList.add('active');
});

